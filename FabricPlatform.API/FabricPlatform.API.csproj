<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>0.0.1</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- Asp.Net Core related packages -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13"/>
        <PackageReference Include="Scalar.AspNetCore" Version="2.18.0"/>
        <!-- Entity Framework Core related packages -->
        <PackageReference Include="EntityFrameworkCore" Version="10.0.13"/>
        <PackageReference Include="EntityFrameworkCore.Relational" Version="10.0.13"/>
        <PackageReference Include="EntityFrameworkCore.Design" Version="10.0.13">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>

        <!-- MySQL Entity Framework Core provider -->
        <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9"/>
        <!-- Naming convention conversion related packages -->
        <PackageReference Include="Humanizer" Version="3.0.10"/>
        <!-- CQRS / mediator related packages -->
        <PackageReference Include="Cortex.Mediator" Version="3.1.2"/>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Batches\Resources\Messages\BatchesMessages.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>BatchesMessages.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Batches\Resources\Messages\BatchesMessages.en.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>BatchesMessages.en.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Batches\Resources\Messages\BatchesMessages.es.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>BatchesMessages.es.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Batches\Resources\Errors\ErrorMessages.en.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>ErrorMessages.en.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Batches\Resources\Errors\ErrorMessages.es.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>ErrorMessages.es.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Batches\Resources\Messages\BatchesMessages.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>BatchesMessages.resx</DependentUpon>
      </Compile>
      <Compile Update="Batches\Resources\Messages\BatchesMessages.en.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>BatchesMessages.en.resx</DependentUpon>
      </Compile>
      <Compile Update="Batches\Resources\Messages\BatchesMessages.es.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>BatchesMessages.es.resx</DependentUpon>
      </Compile>
      <Compile Update="Batches\Resources\Errors\ErrorMessages.en.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>ErrorMessages.en.resx</DependentUpon>
      </Compile>
      <Compile Update="Batches\Resources\Errors\ErrorMessages.es.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>ErrorMessages.es.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
