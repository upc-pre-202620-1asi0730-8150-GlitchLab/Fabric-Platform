@FabricPlatform.API_HostAddress = http://localhost:5242

### Register a machine
POST {{FabricPlatform.API_HostAddress}}/api/v1/machines
Content-Type: application/json
Accept-Language: es

{
  "code": "MAQ-001",
  "type": "Recta",
  "location": "Línea 1",
  "acquiredDate": "2024-03-15"
}

### Get all machines
GET {{FabricPlatform.API_HostAddress}}/api/v1/machines
Accept: application/json

### Get machine by code
GET {{FabricPlatform.API_HostAddress}}/api/v1/machines?code=MAQ-001
Accept: application/json

### Get machine by id
GET {{FabricPlatform.API_HostAddress}}/api/v1/machines/1
Accept: application/json

### Update machine status
PATCH {{FabricPlatform.API_HostAddress}}/api/v1/machines/1/status
Content-Type: application/json

{
  "status": "InMaintenance"
}

### Report a downtime
POST {{FabricPlatform.API_HostAddress}}/api/v1/machines/1/downtimes
Content-Type: application/json

{
  "reason": "Rotura de aguja",
  "startTime": "2026-11-03T08:00:00"
}

### Resume operation
PATCH {{FabricPlatform.API_HostAddress}}/api/v1/machines/1/downtimes/1/resumption
Content-Type: application/json

{
  "endTime": "2026-11-03T08:45:00",
  "solution": "Cambio de aguja y calibración"
}

### Get downtimes of a machine
GET {{FabricPlatform.API_HostAddress}}/api/v1/machines/1/downtimes
Accept: application/json

### Register a maintenance
POST {{FabricPlatform.API_HostAddress}}/api/v1/machines/1/maintenances
Content-Type: application/json

{
  "technician": "Juan Pérez",
  "maintenanceType": "Preventive",
  "description": "Lubricación y ajuste de tensión",
  "performedDate": "2026-11-03"
}

### Get maintenance history
GET {{FabricPlatform.API_HostAddress}}/api/v1/machines/1/maintenances
Accept: application/json

### Register a fabric inspection
POST {{FabricPlatform.API_HostAddress}}/fabricInspections
Content-Type: application/json

{
  "rollId": "ROLL-001",
  "supplier": "Textil San Pedro S.A.C.",
  "inspectionDate": "2026-11-09",
  "sample": "Jersey 30/1 Pima",
  "color": "Navy",
  "initialResult": "Conforming",
  "rollStatus": "Available for Cutting"
}
